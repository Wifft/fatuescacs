{
  "name": "fatuescacs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/copy-engine.mjs && node scripts/build-licenses.mjs",
    "golden:record": "tsx scripts/record-golden.mts record",
    "golden:expected": "tsx scripts/record-golden.mts expected",
    "bench": "node scripts/bench.mjs",
    "openings:build": "tsx scripts/build-openings.mts",
    "prebuild": "node scripts/build-licenses.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "lz-string": "1.5.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-chessboard": "5.12.4",
    "react-dom": "19.3.0",
    "stockfish": "19.0.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^26.6.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.9",
    "fake-indexeddb": "^6.2.8",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.2"
  },
  "packageManager": "pnpm@10.34.9",
  "description": "Analizador de partidas de ajedrez en el navegador con Stockfish",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wifft/fatuescacs.git"
  },
  "engines": {
    "node": ">=26"
  }
}
